# =====================================================================
# Felo Backend — pre-filled for Supabase project xetosbkkjowlspfxffoj
# =====================================================================
# Copy to .env and fill the [REPLACE-...] placeholders.
#   cp .env.supabase.template .env
#
# After filling in, verify with:  npm run start:dev
# =====================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_PREFIX=v1

# ---- Database connection (Transaction pooler, port 6543) ------------
# Get this from:
#   https://supabase.com/dashboard/project/xetosbkkjowlspfxffoj/settings/database
#   → "Connection string" → URI tab → "Transaction pooler"
#
# It will look like:
#   postgresql://postgres.xetosbkkjowlspfxffoj:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Just replace [REPLACE-WITH-DB-PASSWORD] below — the rest is already filled in.
# Common regions: ca-central-1, us-east-1, ap-south-1, eu-west-1
DATABASE_URL=postgresql://postgres.xetosbkkjowlspfxffoj:[REPLACE-WITH-DB-PASSWORD]@aws-0-[REPLACE-WITH-REGION].pooler.supabase.com:6543/postgres

# ---- Supabase REST + Auth -------------------------------------------
# Project URL is safe to commit. The publishable key is also safe (it's
# designed for clients). The SECRET key MUST stay out of git — paste it
# only into your local .env (gitignored).
#
# Get keys from:
#   https://supabase.com/dashboard/project/xetosbkkjowlspfxffoj/settings/api
SUPABASE_URL=https://xetosbkkjowlspfxffoj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Gp5pDHYMML1658kptTOMcQ_O-pUQVAt
SUPABASE_SECRET_KEY=[REPLACE-WITH-sb_secret_KEY]

# ---- JWT verification (Supabase issues tokens, we verify) -----------
# Backend verifies Supabase Auth JWTs against the public JWKS.
# No shared secret needed — keys are fetched and cached automatically.
SUPABASE_JWKS_URL=https://xetosbkkjowlspfxffoj.supabase.co/auth/v1/.well-known/jwks.json
# Optional fallback for legacy HS256 tokens issued before key rotation
# (leave blank unless you have unexpired tokens that need verifying):
SUPABASE_LEGACY_JWT_SECRET=

# ---- CORS ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Observability (optional) ---------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=
