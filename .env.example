# Felo Backend — environment variables
# Copy to .env and fill in. Do NOT commit .env.

# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_PREFIX=v1

# ---- Database (Supabase or local Postgres) ----
# For local: docker-compose up -d postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/felo

# For Supabase, use the connection string from
#   Project Settings → Database → Connection string → URI
# Choose the "Transaction" pooler for serverless, "Session" for long-lived.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# ---- Auth ----
JWT_SECRET=replace-me-with-a-32-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Firebase service account (used to verify Firebase ID tokens during auth/exchange).
# Either provide path to JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...or paste the JSON inline (escape newlines):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Observability (optional) ----
SENTRY_DSN=
POSTHOG_API_KEY=
