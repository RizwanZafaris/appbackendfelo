# Felo Backend — environment variables
# Copy to .env.local for local dev. NEVER commit a populated .env*.
# All real credentials come from the Ops secret store (see OPS_CONFIG.md).

# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_PREFIX=v1

# ---- Database (Supabase) ----
# IMPORTANT: production MUST use port 5432 (session pool), not 6543
# (transaction pool) — RLS session-local app.user_id requires the
# session pool. See OPS_CONFIG.md → "Database connection".
DATABASE_URL=postgresql://postgres:<password>@<your-project-ref>.supabase.co:5432/postgres

# ---- Auth (Supabase JWKS — no shared secret needed) ----
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
SUPABASE_SECRET_KEY=<sb_secret_...>
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 — leave EMPTY in production once Supabase ECC cutover is done.
SUPABASE_LEGACY_JWT_SECRET=

# ---- Coach LLM (set whichever provider is active) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- CORS (comma-separated origins; never '*') ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Observability ----
SENTRY_DSN=
POSTHOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Encryption (envelope / data-encryption keys; AWS KMS in prod) ----
# Master cipher key for column-level PII encryption.
# Local dev: 32 random bytes hex-encoded. Prod: leave empty + set KMS_KEY_ARN.
SECRET_CIPHER_KEY=
KMS_KEY_ARN=

# ---- Webhook signing (per-provider HMAC secrets) ----
# Used by RemittanceWebhookGuard to verify x-signature on /v1/remittance/webhook/*.
WEBHOOK_SECRET_8B=
WEBHOOK_SECRET_PAYMOB=
WEBHOOK_SECRET_KHALTI=
WEBHOOK_SECRET_SAFEPAY=
WEBHOOK_SECRET_HRC_UBL=
WEBHOOK_SECRET_HABIB_METRO=
WEBHOOK_SECRET_SAMSARA=

# ---- Sanctions / PEP screening provider ----
SANCTIONS_PROVIDER=stub
SANCTIONS_API_KEY=
SANCTIONS_API_URL=

# ---- KYC vendor ----
KYC_PROVIDER=stub
KYC_API_KEY=
KYC_API_URL=

# ---- SMS / OTP provider ----
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_FROM_NUMBER=

# ---- Push notifications (FCM) ----
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ---- Trust proxy CIDR (ingress only) ----
# Set to your load balancer / CDN egress range. Empty = loopback only.
TRUST_PROXY_CIDRS=

# ---- Launch readiness gate ----
# Hard-fail boot in production until this is set to 1, after the deployer
# has confirmed all Ops Config rows are filled. Prevents accidental
# launch with placeholder values.
FELO_LAUNCH_READY=0
