# Felo Backend — environment variables
# Copy to .env and fill in. Do NOT commit .env.

# ---- App ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
API_PREFIX=v1

# ---- Database (Supabase) ----
DATABASE_URL=postgresql://postgres.xetosbkkjowlspfxffoj:[YOUR_DB_PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# ---- Auth (Supabase JWKS - no shared secret needed) ----
# Backend verifies Supabase JWTs via public JWKS endpoint
# No JWT_SECRET needed - Supabase handles signing

# ---- Supabase (for admin operations) ----
SUPABASE_URL=https://xetosbkkjowlspfxffoj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Gp5pDHYMML1658kptTOMcQ_O-pUQVAt
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SECRET_KEY
SUPABASE_JWKS_URL=https://xetosbkkjowlspfxffoj.supabase.co/auth/v1/.well-known/jwks.json

# ---- Coach LLM ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- CORS ----
CORS_ORIGINS=https://feloopsportal.vercel.app,http://localhost:3000,http://localhost:5173

# ---- Observability ----
SENTRY_DSN=
